.venv/
__pycache__/
*.pyc

# Local secrets — SMTP credentials etc. Never commit this file.
api/config.local.php

# Password reset emails written to disk when SMTP isn't configured.
# These contain working reset links, so they must not be committed.
logs/

# Local secrets for the Python service — same role as api/config.local.php.
backend/config.local.json

# Working copies of screenshots used for write-ups. Kept out of the repo
# because they are documentation source material rather than part of the
# app, and because some screenshots of a project like this one show
# credentials, tokens or database contents. Easier to keep the whole folder
# out than to check each image every time.
screenshots/

# Staging copy of the site for FTP upload. Generated, not source — it is
# the same files with the local-only ones stripped out.
_upload-to-server/
