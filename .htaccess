# Security response headers for every request, including the plain .html
# pages. PHP's header() would only cover the .php files, and half this app
# is static — hence Apache rather than PHP.
#
# Needs mod_headers. It ships enabled with XAMPP; if this file ever causes
# a 500, that is the first thing to check:
#
#     httpd -M | findstr headers

<IfModule mod_headers.c>

    # Stop the browser second-guessing a Content-Type. Without it, a file
    # served as text/plain that happens to look like HTML can be treated as
    # HTML — which matters directly here, because users upload files.
    Header always set X-Content-Type-Options "nosniff"

    # No framing, so the interface cannot be loaded invisibly over another
    # page and clicked through. frame-ancestors in the CSP below says the
    # same thing to newer browsers; this covers the older ones.
    Header always set X-Frame-Options "DENY"

    # Send the full URL only to ourselves. Reset links live in URLs, and a
    # referrer header is an easy way for one to leak to a third party.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Nothing here needs a camera, a microphone or a location, so none of
    # them get asked for. Note the listening test does not record — it only
    # plays — so no microphone permission is required.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

    # ── Content Security Policy ────────────────────────────────────────
    #
    # Honest about what this is worth here: 'unsafe-inline' has to stay in
    # script-src because the pages use onclick/onsubmit/onchange handlers
    # in 26 places, and CSP cannot tell those apart from an injected one.
    # So this is NOT the fix for cross-site scripting — escaping the
    # catalogue values in buildIemCard() is. What it does buy:
    #
    #   * script-src pins remote scripts to cdnjs, so an injection cannot
    #     pull in code from anywhere else
    #   * object-src 'none' kills Flash/embed vectors outright
    #   * base-uri 'self' stops an injected <base> silently repointing
    #     every relative URL on the page
    #   * form-action 'self' stops an injected form posting your input to
    #     somebody else's server
    #
    # img-src has to allow https: generally — IEM artwork is hosted by the
    # retailers, not by us. data: is there for the QR code, which is drawn
    # into a canvas and read back as a data URI.
    #
    # connect-src and media-src differ on purpose, and the difference is
    # the whole security argument for this feature.
    #
    # connect-src stays narrow: 'self' plus the Audius discovery API, which
    # is what the song search talks to. This is the directive that decides
    # where an injected script could SEND data, so it is the one worth
    # defending. A stolen session or a scraped profile has to leave over a
    # connection, and this list is short enough to audit.
    #
    # media-src allows https: generally, which sounds worse than it is.
    # Audius is decentralised: a stream request redirects to whichever
    # content node holds the file, on domains run by independent operators
    # (audius-creator-12.theblueprint.xyz was the one we hit first). There
    # is no fixed list to allow. media-src only governs where audio may be
    # LOADED from — it grants no ability to send anything anywhere, and the
    # worst an injection could do with it is play a sound.
    #
    # Note this also requires the audio element to carry
    # crossOrigin="anonymous". Without it the Web Audio graph treats the
    # stream as tainted and outputs silence rather than refusing outright,
    # which is a confusing failure to debug.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.audius.co; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # Only meaningful over HTTPS, and deliberately not set here. Turning on
    # HSTS while developing over http://localhost pins the browser to a
    # scheme this install does not serve, and undoing that means clearing
    # site data by hand. Enable it alongside 'force_https' in config, on a
    # host that actually has a certificate:
    #
    #   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

</IfModule>

# Directory listings off, so a URL with no index file shows nothing rather
# than the contents of the folder.
Options -Indexes

# Config, logs, SQL and the Python service are not web content. Apache
# should not serve them even if someone guesses the path.
#
# Checked before adding this: the frontend fetches nothing static except
# the .mp3 samples under data/audio/samples/, so none of these extensions
# is load-bearing. backend/config.local.json is covered by the json rule as
# well as by .gitignore, which is worth having twice.
<FilesMatch "\.(sql|log|json|md|py|ini|cfg)$">
    Require all denied
</FilesMatch>

# The self-tests refuse to run outside the command line anyway. Denying
# them here as well means that refusal never has to be relied on.
<FilesMatch "^(totp_selftest|smtp_test)\.php$">
    Require all denied
</FilesMatch>


# ── Do not cache the pages ───────────────────────────────────────────────
#
# Two separate problems, one rule.
#
# The one that keeps biting us: a browser holds onto an .html page and goes
# on showing an old build after the file has been replaced on the server.
# It looks exactly like a failed upload, and we have chased it three times
# now -- each time the fix was a junk query string, which is a workaround a
# user will never think of. A panel opening the site on their own laptop
# would hit the same thing.
#
# The one that matters more: pages behind the login guard. Without
# no-store, pressing Back after logging out redisplays the previous user's
# profile from the cache, with no request to the server and therefore no
# chance for the session check to refuse it. The data on screen is real and
# the viewer is not signed in.
#
# no-store rather than no-cache, because no-cache still permits storage and
# only requires revalidation -- and the back/forward cache is allowed to
# skip that.
#
# Deliberately limited to .html and .php. The stylesheet, the scripts and
# the audio SHOULD be cached: they carry ?v= markers when they change, and
# a four-megabyte track re-downloaded on every page view would be far worse
# than a stale page.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Same for anything under tests/. These are never uploaded, but a rule
# that only works because a directory happens to be absent is not a rule.
<FilesMatch "_selftest\.php$">
    Require all denied
</FilesMatch>
